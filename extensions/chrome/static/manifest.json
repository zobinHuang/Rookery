{
    "manifest_version": 3,
    "name": "MuxShots Mixer",
    "description": "Mix each tab's sound on its own from the MuxShots mixer.",
    "version": "0.1.0",
    "key": "",
    "minimum_chrome_version": "120",
    "permissions": ["nativeMessaging", "tabs", "tabCapture", "offscreen", "alarms", "scripting", "storage"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "all_frames": true,
            "match_about_blank": true,
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_title": "Capture this tab's sound for the MuxShots mixer",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    }
}
