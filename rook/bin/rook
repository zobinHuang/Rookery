#!/usr/bin/env bash
# [rook]
set -euo pipefail

usage() {
  echo "Usage:"
  echo "  rook new <session-name>     Create and attach to a new rook session"
  echo "  rook attach <name>          Attach to an existing session"
  echo "  rook ls                     List all rook sessions"
  echo "  rook kill <name>            Kill a session by name"
  echo "  rook exit                   Kill current session"
  echo ""
  echo "  rook connect <host> <port> --token <token>"
  echo "                              Upload agent session history to a roost server"
  echo "  rook disconnect             Stop uploading session history"
  echo "  rook sessions               Show the upload connection and its backlog"
  echo "  rook resource <command>     Read and change roost's agents, skills, playbooks and memories"
  echo "  rook message <agent> <text> Send text to an agent, as the agent in this pane"
  echo "  rook link [status]          Show the live link to roost"
  echo "  rook link prompts on|off    Let prompts from Rookery and other agents reach agents here"
  exit 1
}

if [ $# -lt 1 ]; then
  usage
fi

CMD="$1"
shift

case "$CMD" in
  exit)
    if [ -n "${TMUX:-}" ]; then
      tmux kill-session
    else
      echo "Not inside a tmux session."
    fi
    ;;
  attach)
    if [ $# -lt 1 ]; then
      echo "Usage: rook attach <session-name>"
      exit 1
    fi
    SESSION_NAME="$(whoami)-$1"
    if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
      tmux attach-session -t "$SESSION_NAME"
    else
      echo "Session '$SESSION_NAME' not found."
      echo "Available sessions:"
      tmux list-sessions 2>/dev/null || echo "  (none)"
      exit 1
    fi
    ;;
  ls)
    PREFIX="$(whoami)-"
    FOUND=0
    NOW=$(date +%s)
    while IFS="|" read -r SNAME CREATED; do
      if [[ "$SNAME" == "$PREFIX"* ]]; then
        SHORT="${SNAME#$PREFIX}"
        ELAPSED=$(( NOW - CREATED ))
        DAYS=$(( ELAPSED / 86400 ))
        HOURS=$(( (ELAPSED % 86400) / 3600 ))
        MINS=$(( (ELAPSED % 3600) / 60 ))
        if [ "$DAYS" -gt 0 ]; then
          DUR="${DAYS}d ${HOURS}h"
        elif [ "$HOURS" -gt 0 ]; then
          DUR="${HOURS}h ${MINS}m"
        else
          DUR="${MINS}m"
        fi
        CREATED_FMT=$(date -d "@$CREATED" "+%Y-%m-%d %H:%M" 2>/dev/null || date -r "$CREATED" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "unknown")
        printf "  %-20s created: %s  uptime: %s\n" "$SHORT" "$CREATED_FMT" "$DUR"
        FOUND=1
      fi
    done < <(tmux list-sessions -F "#{session_name}|#{session_created}" 2>/dev/null || true)
    if [ "$FOUND" -eq 0 ]; then
      echo "No rook sessions."
    fi
    ;;
  kill)
    if [ $# -lt 1 ]; then
      echo "Usage: rook kill <session-name>"
      exit 1
    fi
    SESSION_NAME="$(whoami)-$1"
    if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
      tmux kill-session -t "$SESSION_NAME"
      echo "Killed session: $1"
    else
      echo "Session '$1' not found."
    fi
    ;;
  new)
    NAME=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --) shift; NAME="${1:-}"; break ;;
        -*) echo "rook new: unknown flag $1" >&2; exit 1 ;;
        *)  NAME="$1"; shift ;;
      esac
    done
    if [ -z "$NAME" ]; then
      echo "Usage: rook new <session-name>"
      exit 1
    fi
    SESSION_NAME="$(whoami)-$NAME"
    if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
      echo "Session '$SESSION_NAME' already exists. Use 'rook attach $NAME' instead."
      exit 1
    fi
    tmux new-session -d -s "$SESSION_NAME" -c "$HOME"
    tmux attach-session -t "$SESSION_NAME"
    ;;
  connect|disconnect)
    exec "$HOME/.local/bin/rook-session" "$CMD" "$@"
    ;;
  sessions)
    exec "$HOME/.local/bin/rook-session" status
    ;;
  resource|message)
    exec "$HOME/.local/bin/rook-client" "$CMD" "$@"
    ;;
  link)
    [ $# -gt 0 ] || set -- status
    exec "$HOME/.local/share/rook/venv/bin/python" "$HOME/.local/bin/rook-link" "$@"
    ;;
  -h|--help) usage ;;
  *)         usage ;;
esac
