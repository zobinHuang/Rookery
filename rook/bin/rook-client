#!/usr/bin/env python3
import argparse
import fcntl
import hashlib
import json
import os
import platform
import re
import secrets
import socket
import ssl
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from collections.abc import Callable, Iterator
from contextlib import contextmanager
from dataclasses import asdict, dataclass
from datetime import datetime, timezone
from pathlib import Path


class RookClientError(Exception):
    """A failure talking to roost, or reading rook's own files."""

    def __init__(self, message: str) -> None:
        super().__init__(message)
        self.message = message


class RookPaths:
    """Where rook keeps its configuration and its state, following the XDG directories."""

    PATHS_APP_NAME = "rook"

    @classmethod
    def config_dir(cls) -> Path:
        """The directory of rook's configuration."""
        return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / cls.PATHS_APP_NAME

    @classmethod
    def state_dir(cls) -> Path:
        """The directory of rook's state: the event queue, the lock and the log."""
        return Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / cls.PATHS_APP_NAME

    @classmethod
    def connect_file(cls) -> Path:
        """The roost server this machine reports to, written by `rook connect`."""
        return cls.config_dir() / "connect.json"

    @classmethod
    def config_file(cls) -> Path:
        """rook's own settings, such as the name setup asked for."""
        return cls.config_dir() / "config.json"

    @classmethod
    def queue_file(cls) -> Path:
        """Events waiting to be sent, one JSON object a line."""
        return cls.state_dir() / "events.jsonl"

    @classmethod
    def sending_file(cls) -> Path:
        """Events taken off the queue and being sent, kept until roost has them."""
        return cls.state_dir() / "events.sending.jsonl"

    @classmethod
    def flush_lock_dir(cls) -> Path:
        """Held by the one process sending events."""
        return cls.state_dir() / "locks" / "events"

    @classmethod
    def agent_states_dir(cls) -> Path:
        """The last state reported for each session, so a state is sent once."""
        return cls.state_dir() / "agent-states"

    @classmethod
    def log_file(cls) -> Path:
        """What the event sender did."""
        return cls.state_dir() / "events.log"

    @classmethod
    def agent_panes_dir(cls) -> Path:
        """Where each session runs: its tmux server and pane, and which session each pane runs last."""
        return cls.state_dir() / "agent-panes"

    @classmethod
    def mailbox_dir(cls) -> Path:
        """Messages held for busy agents, one file a session, read by their Stop hook."""
        return cls.state_dir() / "mailbox"

    @classmethod
    def receipts_file(cls) -> Path:
        """The deliveries Stop hooks handed to their agents, for rook-link to report."""
        return cls.mailbox_dir() / "receipts.jsonl"

    @classmethod
    def link_status_file(cls) -> Path:
        """Whether rook-link's link is up, and to where or why not."""
        return cls.state_dir() / "link.status.json"

    @classmethod
    def link_pid_file(cls) -> Path:
        """The process id of the running rook-link."""
        return cls.state_dir() / "link.pid"

    @classmethod
    def deliveries_dir(cls) -> Path:
        """The deliveries rook-link holds, and what became of each."""
        return cls.state_dir() / "deliveries"

    @staticmethod
    def key_of(text: str) -> str:
        """A file name for a session id or a pane, which may hold characters a file name cannot."""
        return hashlib.sha256(text.encode("utf-8")).hexdigest()[:32]


class RookConfig:
    """rook's own settings."""

    CONFIG_NAME_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
    """The ways Claude Code is started whose sessions rook reports: in a terminal, or in VS Code. Sessions an
    other program starts for itself, as Raft's agents (`raft`) or a script's `claude -p` (`sdk-cli`), are no
    agents the user oversees and no pane rook can reach, so they are left out."""
    CONFIG_DEFAULT_ENTRYPOINTS = ("cli", "claude-vscode")
    CONFIG_ENTRYPOINT_ENV = "CLAUDE_CODE_ENTRYPOINT"
    """The tmux option rook sets on the sessions and windows it opens, and the variable a program that starts
    an agent of rook's outside tmux, as Rookery starts Raven, sets instead. Only agents in one are rook's."""
    CONFIG_SESSION_MARK = "@rook-session"
    CONFIG_SESSION_ENV = "ROOK_SESSION"
    CONFIG_TMUX_TIMEOUT_SECONDS = 2
    CONFIG_TRANSCRIPT_HEAD_LINES = 20

    @classmethod
    def name(cls) -> str:
        """The name this machine's agents go by, as setup asked for it; the short host name otherwise.

        Returns:
            the name
        """
        name = str(cls._read().get("name") or "")
        if cls.CONFIG_NAME_PATTERN.match(name):
            return name
        return socket.gethostname().split(".")[0] or "rook"

    @classmethod
    def accepts_prompts(cls) -> bool:
        """Whether prompts from Rookery and other agents may be typed into this machine's agents; on unless
        turned off with `rook link prompts off`."""
        return cls._read().get("accepts_prompts") is not False

    @classmethod
    def reports_entrypoint(cls, entrypoint: str | None) -> bool:
        """Whether a Claude Code session started this way is reported: those started as the `entrypoints`
        setting lists, by default in a terminal or in VS Code; one whose start is unknown, as with an older
        Claude Code, is."""
        if not entrypoint:
            return True
        list_entrypoints = cls._read().get("entrypoints")
        if not isinstance(list_entrypoints, list):
            list_entrypoints = list(cls.CONFIG_DEFAULT_ENTRYPOINTS)
        return entrypoint in list_entrypoints

    @classmethod
    def is_rook_session(cls) -> bool:
        """Whether the calling hook's agent runs where rook started it: in a tmux session or window rook
        opened, or with the variable set by a program that starts agents of rook's outside tmux.

        Returns:
            whether the agent is rook's
        """
        if os.environ.get(cls.CONFIG_SESSION_ENV) == "1":
            return True
        pane = os.environ.get("TMUX_PANE")
        if not pane or not os.environ.get("TMUX"):
            return False
        try:
            result = subprocess.run(
                ["tmux", "display-message", "-p", "-t", pane, "#{" + cls.CONFIG_SESSION_MARK + "}"],
                capture_output=True,
                text=True,
                timeout=cls.CONFIG_TMUX_TIMEOUT_SECONDS,
            )
        except (OSError, subprocess.TimeoutExpired):
            return False
        return result.returncode == 0 and result.stdout.strip() != ""

    @classmethod
    def entrypoint_of(cls, transcript: Path) -> str | None:
        """How the session a Claude Code transcript records was started, from its first lines that say."""
        try:
            with transcript.open(encoding="utf-8", errors="replace") as handle:
                for _ in range(cls.CONFIG_TRANSCRIPT_HEAD_LINES):
                    line = handle.readline()
                    if not line:
                        break
                    try:
                        map_line = json.loads(line)
                    except ValueError:
                        continue
                    if isinstance(map_line, dict) and map_line.get("entrypoint"):
                        return str(map_line["entrypoint"])
        except OSError:
            return None
        return None

    @classmethod
    def update(cls, map_changes: dict[str, object]) -> None:
        """Merge settings into the configuration file, keeping the others."""
        map_config = cls._read()
        map_config.update(map_changes)
        path = RookPaths.config_file()
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(map_config, indent=2) + "\n", encoding="utf-8")

    @staticmethod
    def _read() -> dict[str, object]:
        try:
            map_config = json.loads(RookPaths.config_file().read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return {}
        return map_config if isinstance(map_config, dict) else {}


class Connection:
    """The roost server this machine reports to."""

    CONNECTION_TIMEOUT_SECONDS = 30

    def __init__(self, base_url: str, token: str, is_insecure: bool) -> None:
        self.base_url = base_url.rstrip("/")
        self.token = token
        self.is_insecure = is_insecure

    @classmethod
    def load(cls) -> "Connection | None":
        """Read the connection `rook connect` wrote.

        Returns:
            the connection, or None when this machine is not connected
        """
        try:
            map_connect = json.loads(RookPaths.connect_file().read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return None
        if not isinstance(map_connect, dict):
            return None
        base_url = str(map_connect.get("base_url") or "")
        token = str(map_connect.get("token") or "")
        if not base_url or not token:
            return None
        return cls(base_url, token, map_connect.get("insecure") in (True, "true", 1))

    def request(
        self,
        method: str,
        path: str,
        map_body: object = None,
        timeout_seconds: float = CONNECTION_TIMEOUT_SECONDS,
    ) -> dict[str, object]:
        """Send one request to roost.

        Args:
            method: the HTTP method
            path: the path, starting with `/v1/`
            map_body: the JSON body, or None for none
            timeout_seconds: how long to wait for roost

        Returns:
            the decoded response

        Raises:
            RookClientError: if roost cannot be reached or refuses the request
        """
        raw = self.request_bytes(method, path, map_body, timeout_seconds)
        return json.loads(raw) if raw else {}

    def transcript_tail(self, session_id: str, nb_tail_bytes: int) -> bytes:
        """About the last bytes of a session's transcript, from the start of a line, without fetching the
        rest of it.

        Args:
            session_id: the session whose transcript to read
            nb_tail_bytes: how much of its end to read

        Raises:
            RookClientError: if roost cannot be reached or holds no such session
        """
        path = f"/v1/sessions/{urllib.parse.quote(session_id, safe='')}/transcript"
        nb_total = int(self.response_header("GET", f"{path}?limit=1", "X-Rook-Total") or 0)
        offset = max(0, nb_total - nb_tail_bytes)
        raw = self.request_bytes("GET", f"{path}?offset={offset}")
        if offset > 0:
            _, _, raw = raw.partition(b"\n")
        return raw

    def response_header(self, method: str, path: str, header: str) -> str | None:
        """One header of roost's answer to a request whose body is not needed.

        Raises:
            RookClientError: if roost cannot be reached or refuses the request
        """
        request = urllib.request.Request(self.base_url + path, method=method)
        request.add_header("Authorization", f"Bearer {self.token}")
        try:
            with urllib.request.urlopen(request, timeout=self.CONNECTION_TIMEOUT_SECONDS, context=self._context()) as response:
                return response.headers.get(header)
        except urllib.error.HTTPError as err:
            detail = err.read().decode("utf-8", errors="replace")
            raise RookClientError(f"roost answered {err.code}: {detail}") from err
        except (urllib.error.URLError, OSError) as err:
            raise RookClientError(f"cannot reach roost at {self.base_url}: {err}") from err

    def _context(self) -> ssl.SSLContext | None:
        if not self.is_insecure:
            return None
        context = ssl.create_default_context()
        context.check_hostname = False
        context.verify_mode = ssl.CERT_NONE
        return context

    def request_bytes(
        self,
        method: str,
        path: str,
        map_body: object = None,
        timeout_seconds: float = CONNECTION_TIMEOUT_SECONDS,
    ) -> bytes:
        """Send one request to roost and take its answer as it came, for answers that are not one object.

        Raises:
            RookClientError: if roost cannot be reached or refuses the request
        """
        data = None if map_body is None else json.dumps(map_body).encode("utf-8")
        request = urllib.request.Request(self.base_url + path, data=data, method=method)
        request.add_header("Authorization", f"Bearer {self.token}")
        if data is not None:
            request.add_header("Content-Type", "application/json")
        try:
            with urllib.request.urlopen(request, timeout=timeout_seconds, context=self._context()) as response:
                raw = response.read()
        except urllib.error.HTTPError as err:
            detail = err.read().decode("utf-8", errors="replace")
            raise RookClientError(f"roost answered {err.code}: {detail}") from err
        except (urllib.error.URLError, OSError) as err:
            raise RookClientError(f"cannot reach roost at {self.base_url}: {err}") from err
        return raw


class HookEventMapper:
    """Turns one hook payload of a code agent into the events roost takes, following docs/resources.md."""

    MAPPER_MEMORY_PATTERN = re.compile(r"/projects/(?P<project>[^/]+)/memory/(?P<file>[^/]+\.md)$")
    MAPPER_SKILL_PATTERN = re.compile(r"/\.(?:claude|agents)/skills/(?P<name>[^/]+)/")
    MAPPER_WRITE_TOOLS = frozenset({"Write", "Edit", "MultiEdit", "NotebookEdit"})
    MAPPER_SKILL_TOOL = "Skill"
    MAPPER_MEMORY_TEXT_MAX_BYTES = 64 * 1024
    MAPPER_FRONTMATTER_NAME_PATTERN = re.compile(r"^name:\s*(?P<name>.+?)\s*$", re.MULTILINE)
    MAPPER_LIMIT_WORDS = ("rate limit", "usage limit", "rate_limit", "quota")
    MAPPER_SUBPROCESS_TIMEOUT_SECONDS = 2
    MAPPER_TITLE_TAIL_BYTES = 256 * 1024
    MAPPER_TITLE_TYPES = {"custom-title": "customTitle", "ai-title": "aiTitle"}
    """Set by rook-link in a session it starts for a launch, which the session names as it starts."""
    MAPPER_LAUNCH_ENV = "ROOK_LAUNCH"
    MAPPER_NOTIFICATION_STATES = {
        "permission_prompt": "needs_approval",
        "elicitation_dialog": "needs_input",
    }
    MAPPER_EVENT_STATES = {
        "UserPromptSubmit": "thinking",
        "PreToolUse": "working",
        "PostToolUse": "working",
        "PermissionRequest": "needs_approval",
        "PreCompact": "compacting",
        "Stop": "done",
    }

    def __init__(self, harness: str, map_payload: dict[str, object]) -> None:
        self._harness = harness
        self._map_payload = map_payload
        self._session_id = str(map_payload.get("session_id") or "")
        self._hook = str(map_payload.get("hook_event_name") or "")

    @property
    def session_id(self) -> str:
        """The session the payload belongs to, which is the agent's id."""
        return self._session_id

    def events(self) -> list[dict[str, object]]:
        """The events the payload stands for.

        Returns:
            the events, oldest first; none for a payload that says nothing roost keeps
        """
        if not self._session_id:
            return []
        actor = {"kind": "agent", "id": self._session_id}
        if self._hook == "SessionStart":
            return [{"actor": actor, "verb": "started", "at": self.now(), "detail": self._agent_detail()}]
        if self._hook == "SessionEnd":
            return [{"actor": actor, "verb": "ended", "at": self.now()}]
        if self._hook in ("SubagentStart", "SubagentStop"):
            return self._subagent_events()
        list_events: list[dict[str, object]] = []
        state = self._state()
        if state:
            map_detail: dict[str, object] = {"state": state}
            title = self.title()
            if title:
                map_detail["title"] = title
            list_events.append({"actor": actor, "verb": "state", "at": self.now(), "detail": map_detail})
        list_events.extend(self._resource_events(actor))
        return list_events

    def title(self) -> str:
        """The session's title as the harness last wrote it into the transcript: the one the user gave it,
        else the one the harness made up; empty when there is none in the transcript's last stretch.

        Returns:
            the title
        """
        path = str(self._map_payload.get("transcript_path") or "")
        if not path:
            return ""
        try:
            with open(path, "rb") as handle:
                handle.seek(0, os.SEEK_END)
                handle.seek(max(0, handle.tell() - self.MAPPER_TITLE_TAIL_BYTES))
                tail = handle.read().decode("utf-8", errors="replace")
        except OSError:
            return ""
        map_found: dict[str, str] = {}
        for line in reversed(tail.splitlines()):
            if "-title" not in line[:40] and '"type":"custom-title"' not in line and '"type":"ai-title"' not in line:
                continue
            try:
                map_line = json.loads(line)
            except ValueError:
                continue
            kind = map_line.get("type") if isinstance(map_line, dict) else None
            field = self.MAPPER_TITLE_TYPES.get(str(kind))
            if field and kind not in map_found and map_line.get(field):
                map_found[str(kind)] = str(map_line[field])
            if "custom-title" in map_found:
                break
        return map_found.get("custom-title") or map_found.get("ai-title") or ""

    def started_event(self) -> dict[str, object]:
        """The `started` event of the payload's session, for one first seen partway through.

        Returns:
            the event, naming the agent and where it runs
        """
        return {
            "actor": {"kind": "agent", "id": self._session_id},
            "verb": "started",
            "at": self.now(),
            "detail": self._agent_detail(),
        }

    @staticmethod
    def now() -> str:
        """The current time as roost writes it."""
        return datetime.now(timezone.utc).isoformat(timespec="milliseconds")

    def _state(self) -> str | None:
        if self._hook == "Notification":
            kind = str(self._map_payload.get("notification_type") or self._map_payload.get("type") or "")
            return self.MAPPER_NOTIFICATION_STATES.get(kind)
        if self._hook == "StopFailure":
            text = json.dumps(self._map_payload).lower()
            return "rate_limited" if any(word in text for word in self.MAPPER_LIMIT_WORDS) else "error"
        return self.MAPPER_EVENT_STATES.get(self._hook)

    def _resource_events(self, actor: dict[str, object]) -> list[dict[str, object]]:
        tool = str(self._map_payload.get("tool_name") or "")
        map_input = self._map_payload.get("tool_input")
        if not isinstance(map_input, dict):
            return []
        if self._hook == "PreToolUse" and tool == self.MAPPER_SKILL_TOOL:
            name = str(map_input.get("skill") or map_input.get("command") or map_input.get("name") or "").strip()
            if name:
                return [{"actor": actor, "verb": "uses", "at": self.now(), "object": {"kind": "skill", "name": name}}]
            return []
        if self._hook != "PostToolUse" or tool not in self.MAPPER_WRITE_TOOLS:
            return []
        path = str(map_input.get("file_path") or map_input.get("notebook_path") or "")
        memory = self.MAPPER_MEMORY_PATTERN.search(path)
        if memory:
            return [self._memory_event(actor, path, memory.group("project"))]
        skill = self.MAPPER_SKILL_PATTERN.search(path)
        if skill:
            return [{
                "actor": actor,
                "verb": "updated",
                "at": self.now(),
                "object": {"kind": "skill", "name": skill.group("name")},
                "detail": {"path": path},
            }]
        return []

    def _memory_event(self, actor: dict[str, object], path: str, project: str) -> dict[str, object]:
        try:
            raw = Path(path).read_bytes()[: self.MAPPER_MEMORY_TEXT_MAX_BYTES]
        except OSError:
            raw = b""
        text = raw.decode("utf-8", errors="replace")
        heading = self.MAPPER_FRONTMATTER_NAME_PATTERN.search(text)
        name = heading.group("name") if heading else Path(path).stem
        return {
            "actor": actor,
            "verb": "wrote",
            "at": self.now(),
            "object": {"kind": "memory", "id": "m-" + hashlib.sha256(path.encode("utf-8")).hexdigest()[:16], "name": name},
            "detail": {"text": text, "path": path, "project": project},
        }

    def _subagent_events(self) -> list[dict[str, object]]:
        agent_id = str(self._map_payload.get("agent_id") or "").strip()
        agent_type = str(self._map_payload.get("agent_type") or "").strip()
        if not agent_id or not agent_type:
            return []
        child = {"kind": "agent", "id": f"{self._session_id}~{agent_id}"}
        detail = {
            "name": f"{RookConfig.name()}/{self._tab() or 'agent'}/{agent_type}",
            "parent": self._session_id,
            "harness": self._harness,
        }
        list_events: list[dict[str, object]] = [{"actor": child, "verb": "started", "at": self.now(), "detail": detail}]
        if self._hook == "SubagentStop":
            list_events.append({"actor": child, "verb": "ended", "at": self.now()})
        return list_events

    def _agent_detail(self) -> dict[str, object]:
        cwd = str(self._map_payload.get("cwd") or "")
        tab = self._tab()
        rook_name = RookConfig.name()
        map_launch = {"launch": os.environ[self.MAPPER_LAUNCH_ENV]} if os.environ.get(self.MAPPER_LAUNCH_ENV) else {}
        return {
            **map_launch,
            "name": f"{rook_name}/{tab}" if tab else rook_name,
            "harness": self._harness,
            "rook_name": rook_name,
            "tab": tab,
            "cwd": cwd,
            "git_branch": self._git_branch(cwd),
            "transcript_path": self._map_payload.get("transcript_path"),
            "model": self._map_payload.get("model"),
            "title": self.title(),
            "machine": {
                "hostname": socket.gethostname().split(".")[0],
                "os": platform.system(),
                "arch": platform.machine(),
                "user": os.environ.get("USER") or "",
            },
        }

    def _tab(self) -> str:
        pane = os.environ.get("TMUX_PANE")
        if not pane:
            return ""
        return self._run(["tmux", "display-message", "-p", "-t", pane, "#W"])

    def _git_branch(self, cwd: str) -> str:
        if not cwd or not Path(cwd).is_dir():
            return ""
        return self._run(["git", "-C", cwd, "rev-parse", "--abbrev-ref", "HEAD"])

    def _run(self, list_command: list[str]) -> str:
        try:
            completed = subprocess.run(
                list_command,
                capture_output=True,
                text=True,
                timeout=self.MAPPER_SUBPROCESS_TIMEOUT_SECONDS,
                check=False,
            )
        except (OSError, subprocess.SubprocessError):
            return ""
        return completed.stdout.strip() if completed.returncode == 0 else ""


class PlaybookEvents:
    """The events of a playbook loaded into an agent session: the agent follows it and mounts its skills."""

    @staticmethod
    def of(session_id: str, map_resolved: dict[str, object]) -> list[dict[str, object]]:
        """The events for a playbook as roost resolved it for installing.

        Args:
            session_id: the agent session it was loaded into
            map_resolved: the playbook's resolution, as `rook-playbook install` keeps it

        Returns:
            the events: one `follows`, then a `mounts` for each skill it installed
        """
        playbook_id = str(map_resolved.get("id") or "")
        if not session_id or not playbook_id:
            return []
        actor = {"kind": "agent", "id": session_id}
        at = HookEventMapper.now()
        list_events: list[dict[str, object]] = [{
            "actor": actor,
            "verb": "follows",
            "at": at,
            "object": {"kind": "playbook", "id": playbook_id},
        }]
        list_skills = map_resolved.get("skills")
        for skill in list_skills if isinstance(list_skills, list) else []:
            if isinstance(skill, dict) and skill.get("skill_id"):
                list_events.append({
                    "actor": actor,
                    "verb": "mounts",
                    "at": at,
                    "object": {"kind": "skill", "id": str(skill["skill_id"])},
                })
        return list_events


class AgentStateMemo:
    """The last state each session reported, so the tool hooks, which fire on every call, send a state once."""

    @staticmethod
    def is_new(session_id: str, state: str) -> bool:
        """Record a session's state, reporting whether it changed.

        Args:
            session_id: the session
            state: its state now

        Returns:
            True when the state differs from the last one recorded
        """
        path = AgentStateMemo._path(session_id)
        if AgentStateMemo.current(session_id) == state:
            return False
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(state, encoding="utf-8")
        return True

    @staticmethod
    def current(session_id: str) -> str | None:
        """The state a session reported last, or None when it reported none or ended."""
        try:
            return AgentStateMemo._path(session_id).read_text(encoding="utf-8")
        except OSError:
            return None

    @staticmethod
    def changed_at(session_id: str) -> float:
        """When the session's state last changed, as a Unix time; 0 when unknown."""
        try:
            return AgentStateMemo._path(session_id).stat().st_mtime
        except OSError:
            return 0.0

    @staticmethod
    def forget(session_id: str) -> None:
        """Drop a session that ended."""
        AgentStateMemo._path(session_id).unlink(missing_ok=True)

    @staticmethod
    def _path(session_id: str) -> Path:
        return RookPaths.agent_states_dir() / RookPaths.key_of(session_id)


@dataclass
class AgentPane:
    """Where an agent session runs: the tmux server and the pane it was started in."""

    PANE_AGENT_ENV = "ROOK_AGENT_ID"

    session_id: str
    harness: str
    tmux_socket: str
    pane: str

    @classmethod
    def record(cls, session_id: str, harness: str) -> "AgentPane | None":
        """Note the pane the calling hook runs in as the session's, and the session as the pane's latest.

        Args:
            session_id: the session starting
            harness: the code agent running it

        Returns:
            the record, or None outside tmux
        """
        tmux = os.environ.get("TMUX", "")
        pane = os.environ.get("TMUX_PANE", "")
        if not tmux or not pane:
            return None
        agent_pane = cls(session_id=session_id, harness=harness, tmux_socket=tmux.split(",")[0], pane=pane)
        directory = RookPaths.agent_panes_dir()
        directory.mkdir(parents=True, exist_ok=True)
        (directory / RookPaths.key_of(session_id)).write_text(json.dumps(asdict(agent_pane)), encoding="utf-8")
        (directory / cls._pane_key(agent_pane.tmux_socket, pane)).write_text(session_id, encoding="utf-8")
        return agent_pane

    @classmethod
    def of(cls, session_id: str) -> "AgentPane | None":
        """The pane a session started in, or None when it started outside tmux or on another machine."""
        try:
            map_record = json.loads((RookPaths.agent_panes_dir() / RookPaths.key_of(session_id)).read_text())
            return cls(**map_record)
        except (OSError, ValueError, TypeError):
            return None

    @classmethod
    def session_in(cls, tmux_socket: str, pane: str) -> str | None:
        """The session that started last in a pane, or None."""
        try:
            return (RookPaths.agent_panes_dir() / cls._pane_key(tmux_socket, pane)).read_text(encoding="utf-8")
        except OSError:
            return None

    @classmethod
    def session_here(cls) -> str | None:
        """The session that started last in the calling process's pane; outside tmux, the agent the caller
        names in `ROOK_AGENT_ID`, as Raven's conversations in Rookery do; else None."""
        tmux = os.environ.get("TMUX", "")
        pane = os.environ.get("TMUX_PANE", "")
        if tmux and pane:
            return cls.session_in(tmux.split(",")[0], pane)
        return os.environ.get(cls.PANE_AGENT_ENV) or None

    @classmethod
    def latest_tmux_socket(cls) -> str | None:
        """The tmux server the latest session started under, where a new one goes too, or None if none did."""
        directory = RookPaths.agent_panes_dir()
        list_records = [path for path in directory.glob("*") if not path.name.startswith("pane-")] if directory.is_dir() else []
        for path in sorted(list_records, key=lambda path: path.stat().st_mtime, reverse=True):
            try:
                socket_path = str(json.loads(path.read_text(encoding="utf-8")).get("tmux_socket") or "")
            except (OSError, ValueError):
                continue
            if socket_path:
                return socket_path
        return None

    def is_current(self) -> bool:
        """Whether the pane still runs this session, rather than one started in it since."""
        return self.session_in(self.tmux_socket, self.pane) == self.session_id

    @staticmethod
    def _pane_key(tmux_socket: str, pane: str) -> str:
        return "pane-" + RookPaths.key_of(f"{tmux_socket}\n{pane}")


class Mailbox:
    """Messages held for a busy agent until it stops, when its Stop hook hands them over and keeps it going.
    rook-link puts and withdraws them; the hook takes them and leaves a receipt for each."""

    @classmethod
    def put(cls, session_id: str, delivery_id: str, text: str) -> None:
        """Hold a message for a session, once."""
        with cls._locked(session_id) as list_messages:
            if all(message["delivery"] != delivery_id for message in list_messages):
                list_messages.append({"delivery": delivery_id, "text": text})

    @classmethod
    def withdraw(cls, session_id: str, delivery_id: str) -> bool:
        """Take one message back, to deliver another way.

        Returns:
            True when it was still held, False when the hook already handed it over
        """
        with cls._locked(session_id) as list_messages:
            count = len(list_messages)
            list_messages[:] = [message for message in list_messages if message["delivery"] != delivery_id]
            return len(list_messages) < count

    @classmethod
    def take(cls, session_id: str) -> list[dict[str, str]]:
        """Hand over every message held for a session, leaving a receipt for each.

        Returns:
            the messages, oldest first
        """
        with cls._locked(session_id) as list_messages:
            list_taken = list(list_messages)
            list_messages.clear()
        if list_taken:
            with RookPaths.receipts_file().open("a", encoding="utf-8") as handle:
                fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
                for message in list_taken:
                    handle.write(json.dumps({"delivery": message["delivery"], "at": HookEventMapper.now()}) + "\n")
        return list_taken

    @staticmethod
    def drain_receipts() -> list[str]:
        """The deliveries handed over since the last call."""
        path = RookPaths.receipts_file()
        if not path.exists():
            return []
        with path.open("r+", encoding="utf-8") as handle:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
            list_lines = handle.read().splitlines()
            handle.seek(0)
            handle.truncate(0)
        list_ids: list[str] = []
        for line in list_lines:
            try:
                list_ids.append(str(json.loads(line)["delivery"]))
            except (ValueError, KeyError, TypeError):
                continue
        return list_ids

    @staticmethod
    @contextmanager
    def _locked(session_id: str) -> Iterator[list[dict[str, str]]]:
        path = RookPaths.mailbox_dir() / RookPaths.key_of(session_id)
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a+", encoding="utf-8") as handle:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
            handle.seek(0)
            try:
                list_messages = json.loads(handle.read() or "[]")
            except ValueError:
                list_messages = []
            yield list_messages
            handle.seek(0)
            handle.truncate(0)
            handle.write(json.dumps(list_messages))


class EventQueue:
    """Events kept on disk until roost has them. A hook only appends; one sender at a time moves the queue
    behind what is already pending and posts that in batches, oldest first, keeping whatever did not go out
    for the next try."""

    QUEUE_BATCH_SIZE = 200
    QUEUE_LOCK_STALE_SECONDS = 600
    QUEUE_LOG_MAX_BYTES = 256 * 1024

    @staticmethod
    def append(list_events: list[dict[str, object]]) -> None:
        """Add events to the queue.

        Args:
            list_events: the events
        """
        path = RookPaths.queue_file()
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as handle:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
            for event in list_events:
                handle.write(json.dumps(event) + "\n")

    @classmethod
    def flush(cls, send_batch: Callable[[list[object]], None]) -> int:
        """Send what is queued, unless another sender already is.

        Args:
            send_batch: sends one batch to roost, raising RookClientError when it cannot

        Returns:
            how many events were sent

        Raises:
            RookClientError: if roost cannot take them; they stay queued
        """
        with cls._sender_lock() as is_held:
            if not is_held:
                return 0
            sent = 0
            sending = RookPaths.sending_file()
            queue = RookPaths.queue_file()
            if queue.exists():
                with queue.open("r+", encoding="utf-8") as handle:
                    fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
                    queued = handle.read()
                    with sending.open("a", encoding="utf-8") as pending:
                        pending.write(queued)
                    handle.truncate(0)
            if sending.exists():
                sent += cls._send_file(sending, send_batch)
            return sent

    @classmethod
    def log(cls, message: str) -> None:
        """Note what the sender did, keeping the log short."""
        path = RookPaths.log_file()
        path.parent.mkdir(parents=True, exist_ok=True)
        if path.exists() and path.stat().st_size > cls.QUEUE_LOG_MAX_BYTES:
            path.unlink()
        with path.open("a", encoding="utf-8") as handle:
            handle.write(f"{HookEventMapper.now()} {message}\n")

    @classmethod
    def _send_file(cls, path: Path, send_batch: Callable[[list[object]], None]) -> int:
        list_lines = [line for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]
        list_events: list[object] = []
        for line in list_lines:
            try:
                list_events.append(json.loads(line))
            except ValueError:
                cls.log(f"dropped an unreadable queued event: {line[:120]}")
        sent = 0
        while sent < len(list_events):
            batch = list_events[sent: sent + cls.QUEUE_BATCH_SIZE]
            send_batch(batch)
            sent += len(batch)
            remaining = list_events[sent:]
            path.write_text("".join(json.dumps(event) + "\n" for event in remaining), encoding="utf-8")
        path.unlink(missing_ok=True)
        return sent

    @classmethod
    @contextmanager
    def _sender_lock(cls) -> Iterator[bool]:
        lock = RookPaths.flush_lock_dir()
        lock.parent.mkdir(parents=True, exist_ok=True)
        try:
            lock.mkdir()
        except FileExistsError:
            if time.time() - lock.stat().st_mtime < cls.QUEUE_LOCK_STALE_SECONDS:
                yield False
                return
        try:
            yield True
        finally:
            lock.rmdir()


class TranscriptLines:
    """A Claude Code transcript or a codex rollout as a person reads it: who said what, and each tool call
    in one line. Thinking, tool output and injected context are left out."""

    TRANSCRIPT_TOOL_KEYS = ("command", "file_path", "path", "pattern", "url", "description", "prompt", "skill")
    TRANSCRIPT_TOOL_MAX_CHARS = 200

    @classmethod
    def readable(cls, raw: bytes) -> list[str]:
        """The transcript's steps, oldest first.

        Args:
            raw: the transcript's JSONL bytes

        Returns:
            one string per step, prefixed by who it is from
        """
        list_lines: list[str] = []
        for line in raw.decode("utf-8", errors="replace").splitlines():
            try:
                map_line = json.loads(line)
            except ValueError:
                continue
            if not isinstance(map_line, dict):
                continue
            if map_line.get("type") == "response_item" and isinstance(map_line.get("payload"), dict):
                list_lines.extend(cls._codex(map_line["payload"]))
            else:
                list_lines.extend(cls._claude(map_line))
        return list_lines

    @classmethod
    def _claude(cls, map_line: dict[str, object]) -> list[str]:
        role = map_line.get("type")
        if role not in ("user", "assistant") or map_line.get("isSidechain") or map_line.get("isMeta"):
            return []
        message = map_line.get("message")
        content = message.get("content") if isinstance(message, dict) else None
        if isinstance(content, str):
            return cls._said(str(role), content)
        list_lines: list[str] = []
        for block in content if isinstance(content, list) else []:
            if not isinstance(block, dict):
                continue
            if block.get("type") == "text":
                list_lines.extend(cls._said(str(role), str(block.get("text") or "")))
            elif block.get("type") == "tool_use":
                list_lines.append(f"[tool {block.get('name')}] {cls._summary(block.get('input'))}")
        return list_lines

    @classmethod
    def _codex(cls, payload: dict[str, object]) -> list[str]:
        if payload.get("type") == "message" and payload.get("role") in ("user", "assistant"):
            list_lines: list[str] = []
            for block in payload.get("content") or []:
                if isinstance(block, dict):
                    list_lines.extend(cls._said(str(payload["role"]), str(block.get("text") or "")))
            return list_lines
        if payload.get("type") in ("function_call", "custom_tool_call"):
            arguments = payload.get("arguments") or payload.get("input") or ""
            try:
                parsed = json.loads(arguments) if isinstance(arguments, str) else arguments
            except ValueError:
                parsed = arguments
            return [f"[tool {payload.get('name')}] {cls._summary(parsed)}"]
        return []

    @staticmethod
    def _said(role: str, text: str) -> list[str]:
        trimmed = text.strip()
        if not trimmed or (role == "user" and trimmed.startswith("<")):
            return []
        return [f"[{role}] {trimmed}"]

    @classmethod
    def _summary(cls, value: object) -> str:
        if isinstance(value, dict):
            for key in cls.TRANSCRIPT_TOOL_KEYS:
                found = value.get(key)
                if isinstance(found, list):
                    found = " ".join(str(part) for part in found)
                if isinstance(found, str) and found:
                    return found.replace("\n", " ")[: cls.TRANSCRIPT_TOOL_MAX_CHARS]
            return ""
        return str(value)[: cls.TRANSCRIPT_TOOL_MAX_CHARS]


class ResourceCommands:
    """`rook resource`: read and change roost's resources from a terminal, or from an agent."""

    @staticmethod
    def build_parser(parser: argparse.ArgumentParser) -> None:
        """Add the resource subcommands to a parser."""
        commands = parser.add_subparsers(dest="action", required=True)
        list_parser = commands.add_parser("ls", help="list resources")
        list_parser.add_argument("--kind")
        list_parser.add_argument("--q")
        list_parser.add_argument("--limit", type=int, default=100)
        list_parser.add_argument("--json", action="store_true")
        commands.add_parser("kinds", help="list the kinds of resource")
        get_parser = commands.add_parser("get", help="show one resource")
        get_parser.add_argument("kind")
        get_parser.add_argument("id")
        for action in ("create", "update"):
            change_parser = commands.add_parser(action, help=f"{action} a resource")
            change_parser.add_argument("kind")
            if action == "update":
                change_parser.add_argument("id")
            change_parser.add_argument("--name")
            change_parser.add_argument("--attr", action="append", default=[], metavar="KEY=VALUE")
            change_parser.add_argument("--body", help="the whole request body as JSON")
            change_parser.add_argument("--as-agent", help="the session id to log the change as")
        delete_parser = commands.add_parser("delete", help="remove a resource")
        delete_parser.add_argument("kind")
        delete_parser.add_argument("id")
        delete_parser.add_argument("--as-agent")
        relations_parser = commands.add_parser("relations", help="list relations")
        relations_parser.add_argument("kind", nargs="?")
        relations_parser.add_argument("id", nargs="?")
        transcript_parser = commands.add_parser("transcript", help="read an agent session's conversation")
        transcript_parser.add_argument("session_id")
        transcript_parser.add_argument("--last", type=int, default=200, help="only the last N steps")
        skill_file_parser = commands.add_parser(
            "skill-file",
            help="read a skill's SKILL.md, or another of its files, as roost reaches its repository",
        )
        skill_file_parser.add_argument("source", help="a registered skill's id, or a skill's address")
        skill_file_parser.add_argument("--file", default="SKILL.md", help="the file inside the skill's directory")
        events_parser = commands.add_parser("events", help="list recent events")
        events_parser.add_argument("--after", type=int)
        events_parser.add_argument("--limit", type=int, default=50)

    @classmethod
    def run(cls, args: argparse.Namespace, connection: Connection) -> int:
        """Carry out one subcommand, printing its result.

        Returns:
            the process exit status

        Raises:
            RookClientError: if roost refuses the request or the arguments are unusable
        """
        if args.action == "kinds":
            cls._print_json(connection.request("GET", "/v1/kinds")["kinds"])
        elif args.action == "ls":
            query = urllib.parse.urlencode({
                key: value
                for key, value in (("kind", args.kind), ("q", args.q), ("limit", args.limit))
                if value
            })
            list_resources = connection.request("GET", f"/v1/resources?{query}")["resources"]
            if args.json:
                cls._print_json(list_resources)
            else:
                for resource in list_resources:
                    state = resource["attributes"].get("state", "")
                    print(f"{resource['kind']:9} {resource['id'][:40]:40} {resource['name'][:40]:40} {state}")
        elif args.action == "get":
            cls._print_json(connection.request("GET", f"/v1/resources/{args.kind}/{args.id}"))
        elif args.action in ("create", "update"):
            map_body = cls._change_body(args)
            path = f"/v1/resources/{args.kind}" + (f"/{args.id}" if args.action == "update" else "")
            cls._print_json(connection.request("POST" if args.action == "create" else "PATCH", path, map_body))
        elif args.action == "delete":
            map_body = {"actor": {"kind": "agent", "id": args.as_agent}} if args.as_agent else {}
            connection.request("DELETE", f"/v1/resources/{args.kind}/{args.id}", map_body)
        elif args.action == "relations":
            query = f"?kind={args.kind}&id={args.id}" if args.kind and args.id else ""
            cls._print_json(connection.request("GET", f"/v1/relations{query}")["relations"])
        elif args.action == "transcript":
            raw = connection.request_bytes("GET", f"/v1/sessions/{args.session_id}/transcript")
            for line in TranscriptLines.readable(raw)[-args.last:]:
                print(line)
        elif args.action == "skill-file":
            query = urllib.parse.urlencode({"source": args.source, "file": args.file})
            map_read = connection.request("GET", f"/v1/skills/read?{query}")
            print(f"# {map_read['source']} at {str(map_read['commit'])[:12]}: {map_read['path']}")
            sys.stdout.write(str(map_read["text"]))
        elif args.action == "events":
            query = f"?after={args.after}&limit={args.limit}" if args.after is not None else f"?limit={args.limit}"
            cls._print_json(connection.request("GET", f"/v1/events{query}")["events"])
        return 0

    @staticmethod
    def _change_body(args: argparse.Namespace) -> dict[str, object]:
        if args.body:
            try:
                map_body = json.loads(args.body)
            except ValueError as err:
                raise RookClientError(f"--body is not JSON: {err}") from err
            if not isinstance(map_body, dict):
                raise RookClientError("--body must be a JSON object")
        else:
            map_body = {}
        if args.name:
            map_body["name"] = args.name
        if args.attr:
            map_attributes = dict(map_body.get("attributes") or {})
            for assignment in args.attr:
                key, separator, value = assignment.partition("=")
                if not separator or not key:
                    raise RookClientError(f"--attr takes KEY=VALUE, not {assignment!r}")
                map_attributes[key] = value
            map_body["attributes"] = map_attributes
        if args.as_agent:
            map_body["actor"] = {"kind": "agent", "id": args.as_agent}
        return map_body

    @staticmethod
    def _print_json(value: object) -> None:
        json.dump(value, sys.stdout, indent=2, ensure_ascii=False)
        sys.stdout.write("\n")


class AgentCommands:
    """`rook agent`: the fleet as a person or an agent overseeing it reads it: who runs where, in what
    state, who needs a person, and what one of them said and did lately."""

    AGENT_ATTENTION_STATES = ("needs_approval", "needs_input", "error", "rate_limited")
    AGENT_BUSY_STATES = ("thinking", "working", "compacting")
    AGENT_TAIL_BYTES = 400_000
    AGENT_LIST_LIMIT = 500
    AGENT_SUBAGENT_SEPARATOR = "~"
    AGENT_SUBAGENT_SESSION_PREFIX = "agent-"
    """The rook Rookery's own agents report under, as Raven's conversations, which are no agents of the fleet."""
    AGENT_ROOKERY_ROOK = "rookery"

    @staticmethod
    def build_parser(parser: argparse.ArgumentParser) -> None:
        """Add the agent subcommands to a parser."""
        commands = parser.add_subparsers(dest="action", required=True)
        status_parser = commands.add_parser("status", help="every agent's state, those needing a person first")
        status_parser.add_argument("--all", action="store_true", help="list ended agents too")
        status_parser.add_argument("--json", action="store_true")
        tail_parser = commands.add_parser("tail", help="what an agent said and did lately")
        tail_parser.add_argument("agent", help="the agent's id")
        tail_parser.add_argument("--steps", type=int, default=40, help="how many of its latest steps")

    @classmethod
    def run(cls, args: argparse.Namespace, connection: Connection) -> int:
        """Carry out one subcommand, printing its result.

        Returns:
            the process exit status

        Raises:
            RookClientError: if roost refuses the request
        """
        if args.action == "status":
            list_rows = cls.status(connection, is_all=args.all)
            if args.json:
                json.dump(list_rows, sys.stdout, indent=2, ensure_ascii=False)
                sys.stdout.write("\n")
            else:
                cls._print_status(list_rows)
        elif args.action == "tail":
            raw = connection.transcript_tail(cls.transcript_session_id(args.agent), cls.AGENT_TAIL_BYTES)
            for line in TranscriptLines.readable(raw)[-args.steps:]:
                print(line)
        return 0

    @classmethod
    def status(cls, connection: Connection, is_all: bool) -> list[dict[str, object]]:
        """Every session's state, with its subagents counted under it: those needing a person first, then
        those working, then the rest, each group last active first.

        Args:
            connection: the roost to read
            is_all: whether ended sessions are listed too

        Returns:
            one row per session
        """
        list_agents = connection.request("GET", f"/v1/resources?kind=agent&limit={cls.AGENT_LIST_LIMIT}")["resources"]
        list_rooks = connection.request("GET", f"/v1/resources?kind=rook&limit={cls.AGENT_LIST_LIMIT}")["resources"]
        map_online = {rook["id"]: bool(rook["attributes"].get("online")) for rook in list_rooks}
        map_subagents: dict[str, int] = {}
        for agent in list_agents:
            parent = agent["attributes"].get("parent")
            if parent:
                map_subagents[str(parent)] = map_subagents.get(str(parent), 0) + 1
        list_rows: list[dict[str, object]] = []
        for agent in list_agents:
            map_attributes = agent["attributes"]
            state = str(map_attributes.get("state") or "")
            if map_attributes.get("parent") or (state == "ended" and not is_all):
                continue
            if map_attributes.get("rook_name") == cls.AGENT_ROOKERY_ROOK:
                continue
            rook_name = str(map_attributes.get("rook_name") or "")
            cwd = str(map_attributes.get("cwd") or "")
            list_rows.append({
                "id": agent["id"],
                "title": str(map_attributes.get("title") or agent["name"]),
                "state": state,
                "needs_person": state in cls.AGENT_ATTENTION_STATES,
                "rook": rook_name,
                "rook_online": map_online.get(rook_name, False),
                "project": cwd.rstrip("/").rsplit("/", 1)[-1] if cwd else "",
                "branch": str(map_attributes.get("git_branch") or ""),
                "subagents": map_subagents.get(agent["id"], 0),
                "last_used_at": agent["last_used_at"],
            })
        list_rows.sort(key=lambda row: str(row["last_used_at"]), reverse=True)
        list_rows.sort(key=cls._urgency)
        return list_rows

    @classmethod
    def transcript_session_id(cls, agent_id: str) -> str:
        """The session roost keeps an agent's transcript under: its own, or for a subagent, named
        `<parent>~<agent>`, the `agent-<agent>` one its harness writes beside its parent's."""
        _, separator, child = agent_id.partition(cls.AGENT_SUBAGENT_SEPARATOR)
        return f"{cls.AGENT_SUBAGENT_SESSION_PREFIX}{child}" if separator else agent_id

    @classmethod
    def _urgency(cls, row: dict[str, object]) -> int:
        if row["needs_person"]:
            return 0
        if row["state"] in cls.AGENT_BUSY_STATES:
            return 1
        return 3 if row["state"] == "ended" else 2

    @staticmethod
    def _print_status(list_rows: list[dict[str, object]]) -> None:
        if not list_rows:
            print("no agents")
            return
        for row in list_rows:
            flag = "!" if row["needs_person"] else " "
            where = str(row["rook"]) + ("" if row["rook_online"] else " (offline)")
            extra = f" +{row['subagents']} subagents" if row["subagents"] else ""
            place = "/".join(part for part in (row["project"], row["branch"]) if part)
            print(f"{flag} {str(row['state']):15} {str(row['title'])[:40]:40} {where:24} {place}{extra}  [{row['id']}]")


class ProposeCommands:
    """`rook-client propose`: what an overseeing agent would do to another agent, or on a rook, put to the
    person for a decision rather than done. It prints the proposal, which the app shows with a button to
    carry it out."""

    PROPOSE_ID_BYTES = 6
    PROPOSE_APPROVAL_STATE = "needs_approval"
    PROPOSE_APPROVAL_CHOICES = ("once", "deny")
    PROPOSE_HARNESSES = ("claude", "codex")

    @staticmethod
    def build_parser(parser: argparse.ArgumentParser) -> None:
        """Add the propose subcommands to a parser."""
        commands = parser.add_subparsers(dest="action", required=True)
        message_parser = commands.add_parser("message", help="propose text to send an agent")
        message_parser.add_argument("agent", help="the agent's id")
        message_parser.add_argument("text", nargs="+")
        interrupt_parser = commands.add_parser("interrupt", help="propose stopping what an agent is doing")
        interrupt_parser.add_argument("agent")
        approve_parser = commands.add_parser("approve", help="propose answering an agent's approval prompt")
        approve_parser.add_argument("agent")
        approve_parser.add_argument("--choice", choices=ProposeCommands.PROPOSE_APPROVAL_CHOICES, required=True)
        spawn_parser = commands.add_parser("spawn", help="propose starting a new session on a rook")
        spawn_parser.add_argument("rook", help="the rook's name")
        spawn_parser.add_argument("--cwd", required=True, help="the directory on the rook, an absolute path")
        spawn_parser.add_argument("--harness", choices=ProposeCommands.PROPOSE_HARNESSES, default="claude")
        spawn_parser.add_argument("--playbook", help="a playbook to install into the directory first")
        spawn_parser.add_argument("--skill", action="append", default=[], help="a further skill to install; repeatable")
        spawn_parser.add_argument("--role", default="", help="who the new agent is to its teammates")
        spawn_parser.add_argument(
            "--team",
            action="append",
            default=[],
            help="a team it joins, as <team id> or <team id>:<duty>; repeatable",
        )
        spawn_parser.add_argument("prompt", nargs="*", help="its first prompt")
        join_parser = commands.add_parser("join", help="propose putting an agent in a team, or giving it a new duty")
        join_parser.add_argument("team", help="the team's id")
        join_parser.add_argument("agent", help="the agent's id")
        join_parser.add_argument("--duty", default="", help="what it does in the team")
        leave_parser = commands.add_parser("leave", help="propose taking an agent out of a team")
        leave_parser.add_argument("team", help="the team's id")
        leave_parser.add_argument("agent", help="the agent's id")
        team_parser = commands.add_parser("create-team", help="propose making a team")
        team_parser.add_argument("team", help="its id: lowercase letters, digits and dashes")
        team_parser.add_argument("--name", required=True, help="its name")
        team_parser.add_argument("--goal", default="", help="what it works toward")

    @classmethod
    def run(cls, args: argparse.Namespace, connection: Connection) -> int:
        """Check the proposal against roost and print it.

        Returns:
            the process exit status

        Raises:
            RookClientError: if the agent or the rook cannot take it
        """
        action = "create_team" if args.action == "create-team" else args.action
        proposal: dict[str, object] = {"id": "p-" + secrets.token_hex(cls.PROPOSE_ID_BYTES), "action": action}
        if args.action == "create-team":
            if not re.match(r"^[a-z0-9][a-z0-9-]{0,62}$", args.team):
                raise RookClientError("a team's id is lowercase letters, digits and dashes")
            if cls._exists(connection, "team", args.team):
                raise RookClientError(f"team {args.team} exists already")
            proposal.update({
                "team": args.team,
                "team_title": args.name,
                "goal": args.goal,
                "agent_title": args.name,
                "text": "",
            })
        elif args.action in ("join", "leave"):
            team = connection.request("GET", f"/v1/resources/team/{urllib.parse.quote(args.team, safe='')}")
            agent = connection.request("GET", f"/v1/resources/agent/{urllib.parse.quote(args.agent, safe='')}")
            map_members = (team.get("attributes") or {}).get("members") or {}
            if args.action == "leave" and args.agent not in map_members:
                raise RookClientError(f"agent {args.agent} is not in team {args.team}")
            proposal.update({
                "team": args.team,
                "team_title": str(team.get("name") or args.team),
                "agent": args.agent,
                "agent_title": str((agent.get("attributes") or {}).get("title") or agent.get("name") or args.agent),
                "duty": getattr(args, "duty", ""),
                "text": "",
            })
        elif args.action == "spawn":
            rook = connection.request("GET", f"/v1/resources/rook/{urllib.parse.quote(args.rook, safe='')}")
            if not (rook.get("attributes") or {}).get("online"):
                raise RookClientError(f"rook {args.rook} is offline; it cannot start a session now")
            if not args.cwd.startswith("/"):
                raise RookClientError("--cwd must be an absolute path on the rook")
            proposal.update({
                "rook": args.rook,
                "cwd": args.cwd,
                "harness": args.harness,
                "text": " ".join(args.prompt),
                "agent_title": f"{args.harness} on {args.rook}",
                "role": args.role,
                "skills": args.skill,
                "teams": [cls._team_join(connection, spec) for spec in args.team],
            })
            if args.playbook:
                if not cls._exists(connection, "playbook", args.playbook):
                    raise RookClientError(f"no such playbook: {args.playbook}")
                proposal["playbook"] = args.playbook
            for skill_id in args.skill:
                if not cls._exists(connection, "skill", skill_id):
                    raise RookClientError(f"no such skill: {skill_id}")
        else:
            agent = connection.request("GET", f"/v1/resources/agent/{urllib.parse.quote(args.agent, safe='')}")
            map_attributes = agent.get("attributes") or {}
            state = str(map_attributes.get("state") or "")
            if state == "ended":
                raise RookClientError(f"agent {args.agent} has ended")
            if args.action == "approve" and state != cls.PROPOSE_APPROVAL_STATE:
                raise RookClientError(f"agent {args.agent} is not waiting for an approval ({state})")
            proposal.update({
                "agent": args.agent,
                "agent_title": str(map_attributes.get("title") or agent.get("name") or args.agent),
                "text": " ".join(args.text) if args.action == "message" else "",
            })
            if args.action == "approve":
                proposal["choice"] = args.choice
        json.dump({"proposal": proposal}, sys.stdout, ensure_ascii=False)
        sys.stdout.write("\nProposed. The user decides in Rookery; nothing was done. Do not do it another way.\n")
        return 0

    @staticmethod
    def _exists(connection: Connection, kind: str, resource_id: str) -> bool:
        try:
            connection.request("GET", f"/v1/resources/{kind}/{urllib.parse.quote(resource_id, safe='')}")
        except RookClientError as err:
            if "404" in err.message:
                return False
            raise
        return True

    @classmethod
    def _team_join(cls, connection: Connection, spec: str) -> dict[str, str]:
        """A team a new session joins, from `<team id>` or `<team id>:<duty>`, checked against roost."""
        team_id, _, duty = spec.partition(":")
        if not cls._exists(connection, "team", team_id.strip()):
            raise RookClientError(f"no such team: {team_id}")
        return {"team": team_id.strip(), "duty": duty.strip()}


class HostCommands:
    """`rook-client host`: the hosts the user reaches over ssh from Rookery's Mac, with the rook each runs and
    the workdirs the user keeps there, as Rookery wrote them for Raven."""

    HOSTS_FILE_NAME = "hosts.json"

    @staticmethod
    def build_parser(parser: argparse.ArgumentParser) -> None:
        """Add the host subcommands to a parser."""
        commands = parser.add_subparsers(dest="action", required=True)
        list_parser = commands.add_parser("list", help="every host, its rook and its workdirs")
        list_parser.add_argument("--json", action="store_true")

    @classmethod
    def run(cls, args: argparse.Namespace) -> int:
        """Print the hosts.

        Returns:
            the process exit status

        Raises:
            RookClientError: if Rookery wrote no hosts here
        """
        path = RookPaths.config_dir() / cls.HOSTS_FILE_NAME
        try:
            map_hosts = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError) as err:
            raise RookClientError(f"no hosts here; Rookery writes them for Raven ({err})") from err
        if args.json:
            print(json.dumps(map_hosts, indent=2, ensure_ascii=False))
            return 0
        for map_host in map_hosts.get("hosts") or []:
            rook = map_host.get("rook")
            state = "no rook" if not rook else f"rook {rook}, {'online' if map_host.get('online') else 'offline'}"
            print(f"{map_host.get('alias')} ({map_host.get('address')}): {state}")
            for map_workdir in map_host.get("workdirs") or []:
                list_parts = [f"  workdir {map_workdir.get('name')}: {map_workdir.get('path')}, {map_workdir.get('harness')}"]
                if map_workdir.get("playbook"):
                    list_parts.append(f"playbook {map_workdir['playbook']}")
                if map_workdir.get("skills"):
                    list_parts.append("skills " + " ".join(map_workdir["skills"]))
                if map_workdir.get("role"):
                    list_parts.append(f"role {map_workdir['role']!r}")
                for map_team in map_workdir.get("teams") or []:
                    list_parts.append(f"team {map_team.get('team')}" + (f":{map_team['duty']}" if map_team.get("duty") else ""))
                print(", ".join(list_parts))
        for map_rook in map_hosts.get("rooks_without_host") or []:
            print(f"rook {map_rook.get('rook')} (no ssh host here): {'online' if map_rook.get('online') else 'offline'}")
        return 0


class MessageCommands:
    """`rook message`: send text to another agent, as the agent in this pane, or as a person outside one."""

    @staticmethod
    def build_parser(parser: argparse.ArgumentParser) -> None:
        """Add the message arguments to a parser."""
        parser.add_argument("agent", help="the agent's id, its session id")
        parser.add_argument("text", nargs="+")
        parser.add_argument("--as-person", action="store_true", help="send as a person even inside an agent's pane")
        parser.add_argument("--thread", help="the thread this answers, as the message you answer names it")
        parser.add_argument("--no-reply", action="store_true", help="tell the agent no answer is wanted")

    @staticmethod
    def run(args: argparse.Namespace, connection: Connection) -> int:
        """Send the message and print the delivery's id.

        Returns:
            the process exit status

        Raises:
            RookClientError: if roost refuses it
        """
        map_body: dict[str, object] = {
            "to": args.agent,
            "text": " ".join(args.text),
            "options": TeamCommands.prompt_options(args),
        }
        session_id = None if args.as_person else AgentPane.session_here()
        if session_id:
            map_body["actor"] = {"kind": "agent", "id": session_id}
        map_delivery = connection.request("POST", "/v1/messages", map_body)
        TeamCommands.print_sent([map_delivery])
        return 0


class TeamCommands:
    """`rook team`: the teams the agent in this pane is in, who is in each and with what duty, and messages to
    a whole team."""

    @staticmethod
    def build_parser(parser: argparse.ArgumentParser) -> None:
        """Add the team subcommands to a parser."""
        commands = parser.add_subparsers(dest="action", required=True)
        list_parser = commands.add_parser("list", help="the teams this agent is in, or every team outside one")
        list_parser.add_argument("--all", action="store_true", help="every team")
        list_parser.add_argument("--json", action="store_true")
        roster_parser = commands.add_parser("roster", help="who is in a team, with what duty, doing what")
        roster_parser.add_argument("team", help="the team's id")
        roster_parser.add_argument("--json", action="store_true")
        send_parser = commands.add_parser("send", help="message every other member of a team")
        send_parser.add_argument("team", help="the team's id")
        send_parser.add_argument("text", nargs="+")
        send_parser.add_argument("--thread", help="the thread this answers, as the message you answer names it")
        send_parser.add_argument("--no-reply", action="store_true", help="tell them no answer is wanted")

    @classmethod
    def run(cls, args: argparse.Namespace, connection: Connection) -> int:
        """Carry out one subcommand, printing its result.

        Returns:
            the process exit status

        Raises:
            RookClientError: if roost refuses it
        """
        session_id = AgentPane.session_here()
        if args.action == "send":
            map_body: dict[str, object] = {
                "team": args.team,
                "text": " ".join(args.text),
                "options": cls.prompt_options(args),
            }
            if session_id:
                map_body["actor"] = {"kind": "agent", "id": session_id}
            cls.print_sent(connection.request("POST", "/v1/messages", map_body)["messages"])
            return 0
        if args.action == "roster":
            map_team = connection.request("GET", f"/v1/teams/{urllib.parse.quote(args.team, safe='')}")
            print(json.dumps(map_team, indent=2) if args.json else TeamBriefing.team_text(map_team, session_id))
            return 0
        path = "/v1/teams" if args.all or not session_id else f"/v1/teams?agent={urllib.parse.quote(session_id, safe='')}"
        list_teams = connection.request("GET", path)["teams"]
        if args.json:
            print(json.dumps(list_teams, indent=2))
        elif not list_teams:
            print("no teams" if args.all or not session_id else "this agent is in no team")
        else:
            print("\n\n".join(TeamBriefing.team_text(map_team, session_id) for map_team in list_teams))
        return 0

    @staticmethod
    def prompt_options(args: argparse.Namespace) -> dict[str, object]:
        """A message's thread and whether it wants an answer, from its command line."""
        map_options: dict[str, object] = {}
        if getattr(args, "thread", None):
            map_options["thread"] = args.thread
        if getattr(args, "no_reply", False):
            map_options["no_reply"] = True
        return map_options

    @staticmethod
    def print_sent(list_deliveries: list[dict[str, object]]) -> None:
        """Say what became of messages just sent: their thread, and any held for the user."""
        for map_delivery in list_deliveries:
            map_options = map_delivery.get("options") or {}
            line = f"{map_delivery['id']} to {map_delivery['agent_id']} in thread {map_options.get('thread', '-')}"
            if map_delivery.get("status") == "held":
                line += f", held for the user: {(map_delivery.get('detail') or {}).get('reason', '')}"
            print(line)


class MeCommands:
    """`rook me`: who the agent in this pane is to its teammates: its role, and what it works on now."""

    ME_TEXT_MAX_CHARS = 300

    @staticmethod
    def build_parser(parser: argparse.ArgumentParser) -> None:
        """Add the subcommands to a parser."""
        commands = parser.add_subparsers(dest="action")
        role_parser = commands.add_parser("role", help="who you are to your teammates, kept until changed")
        role_parser.add_argument("text", nargs="+")
        focus_parser = commands.add_parser("focus", help="what you work on now; set it as you start and finish")
        focus_parser.add_argument("text", nargs="+")

    @classmethod
    def run(cls, args: argparse.Namespace, connection: Connection) -> int:
        """Show this agent's card, or set its role or its focus.

        Returns:
            the process exit status

        Raises:
            RookClientError: if this is no agent's pane, or roost refuses it
        """
        session_id = AgentPane.session_here()
        if not session_id:
            raise RookClientError("rook me works inside an agent's pane")
        path = f"/v1/resources/agent/{urllib.parse.quote(session_id, safe='')}"
        if args.action in ("role", "focus"):
            text = " ".join(args.text).strip()[: cls.ME_TEXT_MAX_CHARS]
            map_attributes: dict[str, object] = {args.action: text, f"{args.action}_source": "agent"}
            if args.action == "focus":
                map_attributes["focus_at"] = HookEventMapper.now()
            connection.request(
                "PATCH",
                path,
                {"attributes": map_attributes, "actor": {"kind": "agent", "id": session_id}},
            )
            TeamBriefing.forget(session_id)
            print(f"{args.action}: {text}")
            return 0
        map_attributes = connection.request("GET", path).get("attributes") or {}
        print(f"agent {session_id}")
        for key in ("title", "role", "focus", "state", "cwd"):
            print(f"  {key}: {map_attributes.get(key) or '-'}")
        list_teams = connection.request("GET", f"/v1/teams?agent={urllib.parse.quote(session_id, safe='')}")["teams"]
        print(f"  teams: {', '.join(team['id'] for team in list_teams) or '-'}")
        return 0


class InboxCommands:
    """`rook inbox`: the messages the agent in this pane received and sent lately, which a compacted
    conversation may have lost."""

    INBOX_DEFAULT_LIMIT = 20
    INBOX_PREVIEW_CHARS = 300

    @staticmethod
    def build_parser(parser: argparse.ArgumentParser) -> None:
        """Add the arguments to a parser."""
        parser.add_argument("--limit", type=int, default=InboxCommands.INBOX_DEFAULT_LIMIT)
        parser.add_argument("--thread", help="only one thread's messages")

    @classmethod
    def run(cls, args: argparse.Namespace, connection: Connection) -> int:
        """Print the messages, oldest first.

        Returns:
            the process exit status

        Raises:
            RookClientError: if this is no agent's pane, or roost refuses it
        """
        session_id = AgentPane.session_here()
        if not session_id:
            raise RookClientError("rook inbox works inside an agent's pane")
        quoted = urllib.parse.quote(session_id, safe="")
        list_messages = (
            connection.request("GET", f"/v1/messages?agent={quoted}&limit={args.limit}")["messages"]
            + connection.request("GET", f"/v1/messages?sender={quoted}&limit={args.limit}")["messages"]
        )
        list_messages = [
            message
            for message in list_messages
            if message.get("kind") == "prompt"
            and (not args.thread or (message.get("options") or {}).get("thread") == args.thread)
        ]
        list_messages.sort(key=lambda message: str(message["created_at"]))
        if not list_messages:
            print("no messages")
        for message in list_messages[-args.limit:]:
            map_options = message.get("options") or {}
            if message["agent_id"] == session_id:
                party = f"from {message['sender']['kind']} {map_options.get('sender_title') or message['sender']['id']}"
            else:
                party = f"to {message['agent_id']}"
            text = str(message["text"])[: cls.INBOX_PREVIEW_CHARS]
            print(f"{message['created_at'][:16]}  {party}  thread {map_options.get('thread', '-')}  {message['status']}")
            print(f"  {text}")
        return 0


class TeamBriefing:
    """What an agent is told of its teams through its hooks: as its session starts, every team it is in,
    each member's card and duty, and how to reach them; then, before a prompt, what changed in its teams
    since it was last told. Each read waits on roost for a few seconds at most, and a prompt checks at
    most once a minute."""

    BRIEFING_TIMEOUT_SECONDS = 3
    BRIEFING_CHECK_SECONDS = 60
    BRIEFING_DIR_NAME = "teams"
    BRIEFING_RAVEN_ROOK = "rookery"

    @classmethod
    def at_start(cls, connection: Connection, session_id: str) -> str:
        """The briefing for a session starting, or empty when it is in no team; what it was told is kept.

        Raises:
            RookClientError: if roost cannot be reached
        """
        list_teams = cls._fetch(connection, session_id)
        cls._remember(session_id, list_teams)
        if not list_teams:
            return ""
        return "\n\n".join([
            f"[rook] You are agent {session_id}, one of a team of code agents that reach one another through "
            "rook. Your teams, each member with who they are (role), their duty here and what they do now:",
            *[cls.team_text(map_team, session_id) for map_team in list_teams],
            cls._commands_text(),
        ])

    @classmethod
    def changes(cls, connection: Connection, session_id: str) -> str:
        """What changed in a session's teams since it was last told, or empty when nothing did or it was
        checked within the minute.

        Raises:
            RookClientError: if roost cannot be reached
        """
        map_known = cls._recall(session_id) or {}
        if time.time() - float(map_known.get("checked_at") or 0) < cls.BRIEFING_CHECK_SECONDS:
            return ""
        list_teams = cls._fetch(connection, session_id)
        map_old = map_known.get("teams") or {}
        map_new = cls._digest(list_teams)
        cls._remember(session_id, list_teams)
        list_lines: list[str] = []
        for team_id, map_team in map_new.items():
            map_before = map_old.get(team_id)
            if map_before is None:
                duty = map_team["members"].get(session_id, "")
                list_lines.append(f"You joined team {map_team['name']} ({team_id}) as: {duty or 'member'}.")
                continue
            for agent_id, duty in map_team["members"].items():
                if agent_id not in map_before["members"]:
                    list_lines.append(f"Team {team_id}: agent {agent_id} joined as: {duty or 'member'}.")
                elif map_before["members"][agent_id] != duty:
                    list_lines.append(f"Team {team_id}: agent {agent_id}'s duty is now: {duty or 'none'}.")
            for agent_id in map_before["members"]:
                if agent_id not in map_team["members"]:
                    list_lines.append(f"Team {team_id}: agent {agent_id} left.")
            if map_before.get("goal") != map_team.get("goal"):
                list_lines.append(f"Team {team_id}'s goal is now: {map_team.get('goal') or 'none'}.")
        for team_id, map_before in map_old.items():
            if team_id not in map_new:
                list_lines.append(f"You are no longer in team {map_before['name']} ({team_id}).")
        if not list_lines:
            return ""
        return "[rook] Your teams changed:\n" + "\n".join(list_lines) + "\nrook team roster <team> shows them now."

    @staticmethod
    def team_text(map_team: dict[str, object], session_id: str | None) -> str:
        """One team as an agent reads it: its goal, and a line for each member."""
        map_attributes = map_team.get("attributes") or {}
        list_lines = [f"Team {map_team.get('name')} (id {map_team.get('id')})"]
        if map_attributes.get("goal"):
            list_lines[0] += f", goal: {map_attributes['goal']}"
        for map_member in map_team.get("members") or []:
            is_self = map_member.get("id") == session_id
            list_parts = [f"- {'you, ' if is_self else ''}agent {map_member.get('id')}"]
            if map_member.get("title"):
                list_parts.append(f'"{map_member["title"]}"')
            if map_member.get("rook_name") == TeamBriefing.BRIEFING_RAVEN_ROOK:
                list_parts.append("is Raven, the user's assistant in Rookery, speaking for the user: take its asks as the user's")
                list_lines.append(" ".join(list_parts))
                if map_member.get("duty"):
                    list_lines.append(f"    duty here: {map_member['duty']}")
                continue
            list_parts.append(f"on {map_member.get('hostname') or map_member.get('rook_name') or '?'}")
            list_parts.append(f"in {map_member.get('cwd') or '?'}")
            list_parts.append(f"[{map_member.get('state') or 'unknown'}]")
            list_lines.append(" ".join(list_parts))
            for key, label in (("role", "role"), ("duty", "duty here"), ("focus", "now")):
                if map_member.get(key):
                    list_lines.append(f"    {label}: {map_member[key]}")
        return "\n".join(list_lines)

    @classmethod
    def forget(cls, session_id: str) -> None:
        """Have the next prompt check the session's teams again at once."""
        map_known = cls._recall(session_id)
        if map_known is not None:
            map_known["checked_at"] = 0
            cls._path(session_id).write_text(json.dumps(map_known), encoding="utf-8")

    @staticmethod
    def _commands_text() -> str:
        return "\n".join([
            "How to work with them (the rook-team skill says when and how):",
            '- rook message <agent id> "..." to one teammate; rook team send <team> "..." to a whole team',
            "- answer within the thread a message names with --thread <id>; add --no-reply when you need no answer",
            "- rook team roster <team> for who is in it now; rook inbox for messages you received and sent",
            '- rook me role "..." for who you are; rook me focus "..." as you start and finish a piece of work',
        ])

    @classmethod
    def _fetch(cls, connection: Connection, session_id: str) -> list[dict[str, object]]:
        map_body = connection.request(
            "GET",
            f"/v1/teams?agent={urllib.parse.quote(session_id, safe='')}",
            timeout_seconds=cls.BRIEFING_TIMEOUT_SECONDS,
        )
        list_teams = map_body.get("teams")
        return [team for team in list_teams if isinstance(team, dict)] if isinstance(list_teams, list) else []

    @staticmethod
    def _digest(list_teams: list[dict[str, object]]) -> dict[str, dict[str, object]]:
        map_digest: dict[str, dict[str, object]] = {}
        for map_team in list_teams:
            map_members = {
                str(member.get("id")): str(member.get("duty") or "")
                for member in map_team.get("members") or []
            }
            map_digest[str(map_team.get("id"))] = {
                "name": map_team.get("name"),
                "goal": (map_team.get("attributes") or {}).get("goal"),
                "members": map_members,
            }
        return map_digest

    @classmethod
    def _remember(cls, session_id: str, list_teams: list[dict[str, object]]) -> None:
        path = cls._path(session_id)
        path.parent.mkdir(parents=True, exist_ok=True)
        map_digest = cls._digest(list_teams)
        for map_team in map_digest.values():
            map_team["duty"] = map_team["members"].get(session_id, "")
        path.write_text(json.dumps({"checked_at": time.time(), "teams": map_digest}), encoding="utf-8")

    @classmethod
    def _recall(cls, session_id: str) -> dict[str, object] | None:
        try:
            map_known = json.loads(cls._path(session_id).read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return None
        return map_known if isinstance(map_known, dict) else None

    @classmethod
    def _path(cls, session_id: str) -> Path:
        return RookPaths.state_dir() / cls.BRIEFING_DIR_NAME / RookPaths.key_of(session_id)


class RookLinkProcess:
    """Whether rook-link, which sends the queue itself, is running."""

    @staticmethod
    def is_running() -> bool:
        """Whether the process named in rook-link's pid file is alive."""
        try:
            pid = int(RookPaths.link_pid_file().read_text(encoding="utf-8").strip())
            os.kill(pid, 0)
        except (OSError, ValueError):
            return False
        return True


class RookClient:
    """The entry points: the hooks' `event hook`, the background `event flush`, `resource` and `message`."""

    CLIENT_SELF = Path(__file__).resolve()
    CLIENT_STOP_HOOK = "Stop"
    CLIENT_START_HOOK = "SessionStart"
    CLIENT_PROMPT_HOOK = "UserPromptSubmit"
    """The harnesses whose hooks take context to add to the conversation, as rook tells an agent of its teams."""
    CLIENT_CONTEXT_HARNESSES = frozenset({"claude"})
    CLIENT_MESSAGE_SEPARATOR = "\n\n---\n\n"
    CLIENT_SESSION_ID_PATTERN = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")

    @classmethod
    def reports_session(cls, harness: str, transcript: str | None = None) -> bool:
        """Whether a session is one rook reports: one that runs where rook started it, and of those every codex
        session, and a Claude Code session started as `RookConfig.reports_entrypoint` allows. Judged by its
        transcript when given, as when catching up on sessions under way, where only a session rook already
        noted the pane of counts; else by how the calling hook's session was started."""
        if transcript:
            if AgentPane.of(cls.session_id_of_transcript(Path(transcript))) is None:
                return False
        elif not RookConfig.is_rook_session():
            return False
        if harness != "claude":
            return True
        if transcript:
            return RookConfig.reports_entrypoint(RookConfig.entrypoint_of(Path(transcript)))
        return RookConfig.reports_entrypoint(os.environ.get(RookConfig.CONFIG_ENTRYPOINT_ENV))

    @classmethod
    def session_id_of_transcript(cls, transcript: Path) -> str:
        """The session a transcript is of, by its file name: Claude Code names it for the session, and codex
        ends its name with it.

        Args:
            transcript: the transcript's path

        Returns:
            the session id
        """
        match = cls.CLIENT_SESSION_ID_PATTERN.search(transcript.stem)
        return match.group(0) if match else transcript.stem

    @classmethod
    def hook(cls, harness: str) -> int:
        """Take one hook payload from stdin, queue its events, and start a sender. At SessionStart, note the
        pane the session runs in; at Stop, hand the agent the messages held for it, which keeps it going.
        Never fails the agent.

        Returns:
            always 0
        """
        try:
            map_payload = json.loads(sys.stdin.read() or "{}")
            if not isinstance(map_payload, dict) or not cls.reports_session(harness):
                return 0
            mapper = HookEventMapper(harness, map_payload)
            list_events = mapper.events()
            if (
                list_events
                and list_events[0]["verb"] != "started"
                and map_payload.get("hook_event_name") != "SessionEnd"
                and AgentStateMemo.current(mapper.session_id) is None
            ):
                list_events.insert(0, mapper.started_event())
            if (
                list_events
                and list_events[0]["verb"] == "started"
                and list_events[0]["actor"]["id"] == mapper.session_id
            ):
                AgentPane.record(mapper.session_id, harness)
                AgentStateMemo.is_new(mapper.session_id, "idle")
            if map_payload.get("hook_event_name") == cls.CLIENT_STOP_HOOK and mapper.session_id:
                list_messages = Mailbox.take(mapper.session_id)
                if list_messages:
                    json.dump(
                        {
                            "decision": "block",
                            "reason": cls.CLIENT_MESSAGE_SEPARATOR.join(message["text"] for message in list_messages),
                        },
                        sys.stdout,
                    )
                    list_events = [cls._still_thinking(event) for event in list_events]
            list_events = [event for event in list_events if cls._is_worth_sending(mapper, event)]
            cls._brief(harness, mapper, map_payload, list_events)
            if not list_events:
                return 0
            EventQueue.append(list_events)
            if RookPaths.connect_file().exists() and not RookLinkProcess.is_running():
                cls.start_sender()
        except (OSError, ValueError) as err:
            EventQueue.log(f"hook {harness} could not queue its events: {err}")
        return 0

    @classmethod
    def _brief(
        cls,
        harness: str,
        mapper: HookEventMapper,
        map_payload: dict[str, object],
        list_events: list[dict[str, object]],
    ) -> None:
        """Tell a starting session of its teams, and a prompted one of what changed in them; a session a launch
        started has its start sent first, so roost puts it in the teams the launch asked for."""
        hook = map_payload.get("hook_event_name")
        if harness not in cls.CLIENT_CONTEXT_HARNESSES or not mapper.session_id or "~" in mapper.session_id:
            return
        if hook not in (cls.CLIENT_START_HOOK, cls.CLIENT_PROMPT_HOOK):
            return
        connection = Connection.load()
        if connection is None:
            return
        try:
            if hook == cls.CLIENT_START_HOOK:
                if os.environ.get(HookEventMapper.MAPPER_LAUNCH_ENV):
                    connection.request(
                        "POST",
                        "/v1/events",
                        {"events": [mapper.started_event()]},
                        timeout_seconds=TeamBriefing.BRIEFING_TIMEOUT_SECONDS,
                    )
                context = TeamBriefing.at_start(connection, mapper.session_id)
            else:
                context = TeamBriefing.changes(connection, mapper.session_id)
        except RookClientError as err:
            EventQueue.log(f"could not brief {mapper.session_id} on its teams: {err.message}")
            return
        if context:
            json.dump({"hookSpecificOutput": {"hookEventName": hook, "additionalContext": context}}, sys.stdout)

    @classmethod
    def report_playbook(cls, session_id: str, resolved_path: str) -> int:
        """Queue the events of a playbook just loaded into a session, and start a sender.

        Returns:
            0, or 1 when the playbook's resolution cannot be read
        """
        try:
            map_resolved = json.loads(Path(resolved_path).read_text(encoding="utf-8"))
        except (OSError, ValueError) as err:
            EventQueue.log(f"cannot read the playbook at {resolved_path}: {err}")
            return 1
        list_events = PlaybookEvents.of(session_id, map_resolved if isinstance(map_resolved, dict) else {})
        if list_events:
            EventQueue.append(list_events)
            if RookPaths.connect_file().exists() and not RookLinkProcess.is_running():
                cls.start_sender()
        return 0

    @classmethod
    def start_sender(cls) -> None:
        """Send the queue from a process of its own, which outlives the hook that started it."""
        subprocess.Popen(
            [sys.executable, str(cls.CLIENT_SELF), "event", "flush"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )

    @classmethod
    def flush(cls) -> int:
        """Send the queued events, if connected.

        Returns:
            0, or 1 when roost could not take them
        """
        connection = Connection.load()
        if connection is None:
            return 0
        try:
            sent = EventQueue.flush(lambda batch: connection.request("POST", "/v1/events", {"events": batch}))
        except RookClientError as err:
            EventQueue.log(f"send failed, kept for the next try: {err.message}")
            return 1
        if sent:
            EventQueue.log(f"sent {sent} event(s)")
        return 0

    @staticmethod
    def _still_thinking(event: dict[str, object]) -> dict[str, object]:
        if event["verb"] != "state":
            return event
        return {**event, "detail": {"state": "thinking"}}

    @staticmethod
    def _is_worth_sending(mapper: HookEventMapper, event: dict[str, object]) -> bool:
        if event["verb"] == "ended":
            AgentStateMemo.forget(mapper.session_id)
            return True
        if event["verb"] != "state" or event["actor"]["id"] != mapper.session_id:
            return True
        return AgentStateMemo.is_new(mapper.session_id, str(event["detail"]["state"]))


def main(list_argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="rook-client")
    commands = parser.add_subparsers(dest="command", required=True)
    event_parser = commands.add_parser("event")
    event_commands = event_parser.add_subparsers(dest="event_command", required=True)
    hook_parser = event_commands.add_parser("hook")
    hook_parser.add_argument("harness", choices=("claude", "codex"))
    reports_parser = event_commands.add_parser("reports", help="exit 0 if this session is reported, 1 if left out")
    reports_parser.add_argument("harness", choices=("claude", "codex"))
    reports_parser.add_argument("--transcript", help="judge by the transcript rather than this process's start")
    event_commands.add_parser("flush")
    playbook_parser = event_commands.add_parser("playbook")
    playbook_parser.add_argument("session_id")
    playbook_parser.add_argument("resolved_path")
    ResourceCommands.build_parser(commands.add_parser("resource"))
    MessageCommands.build_parser(commands.add_parser("message"))
    AgentCommands.build_parser(commands.add_parser("agent"))
    ProposeCommands.build_parser(commands.add_parser("propose"))
    TeamCommands.build_parser(commands.add_parser("team"))
    MeCommands.build_parser(commands.add_parser("me"))
    InboxCommands.build_parser(commands.add_parser("inbox"))
    HostCommands.build_parser(commands.add_parser("host"))
    args = parser.parse_args(list_argv)
    if args.command == "event":
        if args.event_command == "hook":
            return RookClient.hook(args.harness)
        if args.event_command == "playbook":
            return RookClient.report_playbook(args.session_id, args.resolved_path)
        if args.event_command == "reports":
            return 0 if RookClient.reports_session(args.harness, args.transcript) else 1
        return RookClient.flush()
    if args.command == "host":
        try:
            return HostCommands.run(args)
        except RookClientError as err:
            sys.stderr.write(f"rook: {err.message}\n")
            return 1
    connection = Connection.load()
    if connection is None:
        sys.stderr.write("rook: not connected; run: rook connect <host> <port> --token <token>\n")
        return 1
    try:
        if args.command == "message":
            return MessageCommands.run(args, connection)
        if args.command == "agent":
            return AgentCommands.run(args, connection)
        if args.command == "propose":
            return ProposeCommands.run(args, connection)
        if args.command == "team":
            return TeamCommands.run(args, connection)
        if args.command == "me":
            return MeCommands.run(args, connection)
        if args.command == "inbox":
            return InboxCommands.run(args, connection)
        return ResourceCommands.run(args, connection)
    except RookClientError as err:
        sys.stderr.write(f"rook: {err.message}\n")
        return 1


if __name__ == "__main__":
    sys.exit(main())
